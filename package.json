{
  "name": "jokes-by-jc",
  "private": true,
  "description": "Dev tooling for the Jokes By JC Chrome extension. Nothing here ships; the extension loads unpacked with no build step.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "node --test --test-concurrency=1 tests/e2e/*.test.mjs",
    "check:apis": "node test-apis.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "puppeteer": "25.17.0",
    "vitest": "5.1.0"
  }
}
